---
// Íconos de trazo de la maqueta. Heredan el color del texto.
interface Props {
  name: 'arrow-up-right' | 'arrow-right' | 'download' | 'mail' | 'instagram' | 'play';
  size?: number;
}
const { name, size = 16 } = Astro.props;
---

<svg
  aria-hidden="true"
  width={size}
  height={size}
  viewBox={name === 'play' ? '0 0 10 10' : '0 0 24 24'}
  fill="none"
  stroke="currentColor"
  stroke-width={name === 'instagram' ? 1.8 : 2}
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'download' && <path d="M12 4v12M6 10l6 6 6-6M5 20h14" />}
  {
    name === 'mail' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 7 9 6 9-6" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
      </>
    )
  }
  {name === 'play' && <path d="M1 1 L9 5 L1 9 Z" fill="currentColor" stroke="none" />}
</svg>
