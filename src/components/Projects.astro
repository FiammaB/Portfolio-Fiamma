---
import { ui } from '@/lib/ui';
import type { Lang, Project, ProjectCategory } from '@/lib/types';

interface Props {
  lang: Lang;
  projects: Project[];
}

const { lang, projects } = Astro.props;
const t = ui(lang).projects;
const filters = Object.entries(t.filters) as [ProjectCategory | 'todos', string][];
const count = (id: string) => (id === 'todos' ? projects.length : projects.filter((p) => p.categories.includes(id as ProjectCategory)).length);
const pad = (n: number) => String(n).padStart(2, '0');
const label = (p: Project) => p.domain ?? p.url?.replace(/^https?:\/\//, '').replace(/\/$/, '') ?? p.title;
---

<section id="proyectos" class="section">
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <p class="label">{t.kicker}</p>
        <h2 class="h2 display sans">{t.title}<br /><span class="hl">{t.highlight}</span></h2>
      </div>
      <div class="filters" role="group" aria-label={t.filtersLabel} data-filters>
        {
          filters
            .filter(([id]) => count(id) > 0)
            .map(([id, name], i) => (
              <button type="button" class="pill" data-filter={id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {name}<span class="count">{count(id)}</span>
              </button>
            ))
        }
      </div>
    </div>

    <p class="list-head mono hide-sm">
      <span>{t.listHead}</span>
      <span class="list-count"><span data-project-count>{pad(projects.length)}</span> {t.countLabel}</span>
    </p>

    <div class="plist" data-plist>
      <div class="spot" aria-hidden="true"></div>
      <ul class="list" data-projects>
        {
          projects.map((p, i) => {
            const Row = p.url ? 'a' : 'div';
            const link = p.url ? { href: p.url, target: '_blank', rel: 'noopener' } : {};
            return (
              <li data-cats={p.categories.join(' ')} data-reveal style={`--reveal-index:${Math.min(i, 6)}`}>
                <Row
                  class:list={['prow', p.tone]}
                  {...link}
                  data-row={i}
                  data-tone={p.tone}
                  aria-describedby={`proyecto-${i}`}
                >
                  <span class="num mono" data-num>{pad(i + 1)}</span>
                  <h3 class="pname">
                    {p.title}
                    {p.tone === 'souxion' && <span class="pmark" aria-hidden="true" />}
                  </h3>
                  <span class="pstack mono">{p.stack}</span>
                  <span class:list={['tag mono', p.tone]}>{p.kind}</span>
                  {p.url && <span class="parrow" aria-hidden="true">↗</span>}
                </Row>
                <p class="visually-hidden" id={`proyecto-${i}`}>{p.description}</p>
              </li>
            );
          })
        }
      </ul>

      <!-- Vista previa que sigue al mouse (en celular no se muestra ni descarga) -->
      <div class="preview" aria-hidden="true" data-preview>
        {
          projects.map((p, i) => (
            <div class:list={['pcard', p.tone]} data-card={i}>
              <div class="pbar">
                <span></span><span></span><span></span>
                <span class="pbar-title mono">{label(p)}</span>
              </div>
              {
                p.image ? (
                  <img src={p.image.url} alt="" width={p.image.width} height={p.image.height} loading="lazy" />
                ) : (
                  <div class:list={['placeholder', p.placeholder]}>
                    {p.placeholder === 'souxion' && (
                      <>
                        <img class="ph-icon" src="/img/souxion-isotipo.webp" alt="" width="400" height="327" loading="lazy" />
                        <img class="ph-logo" src="/img/souxion-logo.webp" alt="" width="1002" height="129" loading="lazy" />
                      </>
                    )}
                    {p.placeholder === 'web' && <span class="mono">{label(p)} ↗</span>}
                    {p.placeholder === 'code' && <span class="mono">{t.repo}</span>}
                    {p.placeholder === 'soon' && <span class="mono">{t.soon}</span>}
                  </div>
                )
              }
              <p class="pdesc">{p.description}</p>
              <div class="pfoot">
                <span class="pfoot-name">{p.title}</span>
                {p.url && <span class="pfoot-cta mono">{p.cta} ↗</span>}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 36px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .list-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 12px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .list-count {
    padding-right: 44px;
  }
  .plist {
    position: relative;
    isolation: isolate;
    border-top: 1px solid rgba(196, 181, 255, 0.12);
    --glow: 124, 92, 255;
    --mx: 0px;
    --my: 0px;
  }
  .plist[data-tone='souxion'] {
    --glow: 255, 80, 0;
  }
  .plist[data-tone='dev'] {
    --glow: 245, 199, 107;
  }
  .plist[data-tone='muted'] {
    --glow: 196, 181, 255;
  }
  .spot {
    position: absolute;
    left: 0;
    top: 0;
    width: 640px;
    height: 640px;
    margin: -320px 0 0 -320px;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(30px);
    z-index: -1;
    opacity: 0;
    transform: translate(var(--mx), var(--my));
    background: radial-gradient(circle, rgba(var(--glow), 0.22), transparent 60%);
    transition: opacity 0.5s ease;
  }
  .plist.is-previewing .spot {
    opacity: 1;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li[hidden] {
    display: none;
  }

  /* Fila: al pasar el mouse la cruza una franja de luz del color del proyecto */
  .prow {
    --g: rgba(124, 92, 255, 0.5);
    display: grid;
    /* Columnas fijas para que tecnologías y etiquetas queden alineadas entre filas */
    grid-template-columns: 40px minmax(0, 1fr) 230px 140px 20px;
    align-items: center;
    gap: 24px;
    min-height: 76px;
    padding: 0 12px 0 4px;
    border-bottom: 1px solid rgba(196, 181, 255, 0.12);
    color: var(--text);
    background-repeat: no-repeat;
    background-size: 0% 100%;
    transition:
      background-size 0.6s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.4s ease,
      box-shadow 0.6s ease;
  }
  .prow:focus-visible {
    background-size: 100% 100%;
    outline: 2px solid var(--lilac);
    outline-offset: -2px;
  }
  .prow.accent {
    background-image: linear-gradient(90deg, rgba(124, 92, 255, 0) 0%, rgba(124, 92, 255, 0.18) 40%, rgba(124, 92, 255, 0.7) 78%, #dcd4ff 100%);
  }
  .prow.souxion {
    --g: rgba(255, 80, 0, 0.5);
    background-image: linear-gradient(90deg, rgba(255, 80, 0, 0) 0%, rgba(255, 80, 0, 0.18) 40%, rgba(255, 80, 0, 0.7) 78%, #ffd2b0 100%);
  }
  .prow.dev {
    --g: rgba(245, 199, 107, 0.5);
    background-image: linear-gradient(90deg, rgba(245, 199, 107, 0) 0%, rgba(245, 199, 107, 0.1) 40%, rgba(245, 199, 107, 0.38) 78%, #fff0c8 100%);
  }
  .prow.muted {
    --g: rgba(196, 181, 255, 0.5);
    background-image: linear-gradient(90deg, rgba(196, 181, 255, 0) 0%, rgba(196, 181, 255, 0.1) 40%, rgba(196, 181, 255, 0.38) 78%, #ece8ff 100%);
  }
  .num {
    font-size: 12px;
    color: var(--faint);
  }
  .pname {
    min-width: 0;
    font-family: var(--font);
    font-size: 30px;
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.03em;
    transition:
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1),
      text-shadow 0.45s ease;
  }
  .pmark {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-left: 10px;
    border-radius: 50%;
    vertical-align: 0.35em;
    background: var(--orange);
    box-shadow: 0 0 10px var(--orange);
  }
  .pstack {
    font-size: 12px;
    color: var(--muted-2);
    transition: color 0.4s ease;
  }
  .tag {
    justify-self: end;
    font-size: 11px;
    padding: 6px 12px;
    border-radius: 999px;
    white-space: nowrap;
    transition:
      background 0.4s ease,
      color 0.4s ease;
  }
  .tag.souxion {
    background: var(--orange);
    color: #fff;
  }
  .tag.accent {
    background: var(--accent);
    color: #fff;
  }
  .tag.dev {
    background: var(--yellow);
    color: #1a1205;
  }
  .tag.muted {
    border: 1px solid var(--line-strong);
    color: #c9c1e6;
  }
  .parrow {
    font-size: 20px;
    color: var(--faint);
    transition:
      transform 0.35s ease,
      color 0.35s ease;
  }
  @media (hover: hover) {
    .prow:hover {
      background-size: 100% 100%;
      box-shadow:
        40px 0 70px -12px var(--g),
        inset 0 1px 0 var(--g);
    }
    .list:hover .prow:not(:hover) {
      opacity: 0.32;
    }
    .prow:hover .pname {
      transform: translateX(14px);
      text-shadow: 0 0 28px var(--g);
    }
    .prow:hover .pstack {
      color: var(--text);
    }
    .prow:hover .parrow {
      transform: rotate(45deg);
      color: var(--bg);
    }
    /* Sobre la punta clara de la luz, la etiqueta sin relleno necesita fondo propio */
    .prow:hover .tag.muted {
      background: var(--bg);
      color: var(--text);
    }
  }

  /* Vista previa flotante: una tarjeta por proyecto, apiladas en la misma celda */
  .preview {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    display: grid;
    width: 360px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(196, 181, 255, 0.2);
    background: var(--bg);
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.6),
      0 0 60px rgba(var(--glow), 0.25);
    pointer-events: none;
    opacity: 0;
    transform: translate(var(--px, 0), var(--py, 0)) rotate(var(--pr, -6deg)) scale(0.85);
    transition:
      opacity 0.3s ease,
      transform 0.45s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .plist.is-previewing .preview {
    opacity: 1;
    transform: translate(var(--px, 0), var(--py, 0)) rotate(var(--pr, -2deg)) scale(1);
  }
  .pcard {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transition: opacity 0.25s ease;
    background: var(--bg);
  }
  .pcard.is-on {
    opacity: 1;
  }
  .pbar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--surface);
    border-bottom: 1px solid rgba(196, 181, 255, 0.14);
  }
  .pbar > span:not(.pbar-title) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #3a3157;
  }
  .pbar-title {
    flex: 1;
    min-width: 0;
    text-align: center;
    font-size: 10px;
    color: var(--muted-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pcard > img,
  .placeholder {
    flex: none;
    width: 100%;
    height: 200px;
    object-fit: cover;
    object-position: top;
  }
  .placeholder {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: var(--muted-2);
  }
  .placeholder.web {
    background: radial-gradient(circle at 75% 110%, rgba(255, 80, 0, 0.75), #1a0500 55%, var(--bg-deep));
    color: #fff;
  }
  .placeholder.web .mono {
    padding: 0 16px;
    text-align: center;
  }
  .placeholder.code {
    background:
      repeating-linear-gradient(0deg, rgba(196, 181, 255, 0.05) 0 1px, transparent 1px 26px),
      #0e0a1a;
  }
  .placeholder.soon {
    background: repeating-linear-gradient(135deg, rgba(245, 199, 107, 0.06) 0 12px, transparent 12px 24px), #0e0a1a;
    color: var(--yellow);
  }
  .placeholder.souxion {
    background: radial-gradient(ellipse 70% 60% at 60% 120%, rgba(255, 80, 0, 0.85), #1a0500 55%, #000);
  }
  .ph-icon {
    position: absolute;
    left: 6%;
    top: 8%;
    width: 7%;
    height: auto;
  }
  .ph-logo {
    width: 56%;
    height: auto;
    filter: brightness(0) invert(1);
  }
  .pdesc {
    flex: 1;
    padding: 12px 14px;
    font-size: 13px;
    line-height: 1.55;
    color: #b9b1d6;
  }
  .pfoot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 14px;
    background: #0e0a1a;
    border-top: 1px solid rgba(196, 181, 255, 0.12);
  }
  .pfoot-name {
    min-width: 0;
    font-size: 13px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pfoot-cta {
    flex: none;
    font-size: 11px;
    color: var(--lilac);
  }
  .souxion .pfoot-cta {
    color: var(--peach);
  }

  @media (max-width: 1000px) {
    .prow {
      grid-template-columns: 32px minmax(0, 1fr) 170px 124px 20px;
      gap: 16px;
    }
    .pname {
      font-size: 24px;
    }
  }
  /* Sin mouse o en pantallas chicas no hay vista previa (ni se descargan sus imágenes) */
  @media (hover: none), (max-width: 760px) {
    .preview,
    .spot {
      display: none;
    }
  }
  @media (max-width: 760px) {
    .head {
      margin-bottom: 20px;
      gap: 18px;
    }
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 6px;
      width: calc(100% + 2 * var(--gutter));
      margin: 0 calc(-1 * var(--gutter));
      padding: 2px var(--gutter) 4px;
      scrollbar-width: none;
    }
    .filters::-webkit-scrollbar {
      display: none;
    }
    .filters .pill {
      flex: none;
      font-size: 12px;
      padding: 8px 12px;
    }
    .prow {
      display: grid;
      grid-template-columns: 22px minmax(0, 1fr) auto;
      grid-template-areas:
        'num name tag'
        '. stack tag';
      gap: 3px 10px;
      min-height: 60px;
      padding: 12px 0;
    }
    .num {
      grid-area: num;
      font-size: 10px;
    }
    .pname {
      grid-area: name;
      font-size: 18px;
    }
    .pmark {
      display: none;
    }
    .pstack {
      grid-area: stack;
      font-size: 11px;
    }
    .tag {
      grid-area: tag;
      font-size: 10px;
      padding: 4px 8px;
    }
    .parrow {
      display: none;
    }
  }
</style>
