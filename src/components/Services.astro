---
import Icon from './Icon.astro';
import { whatsappUrl } from '@/lib/content';
import { ui } from '@/lib/ui';
import type { Lang, Service, Settings } from '@/lib/types';

interface Props {
  lang: Lang;
  settings: Settings;
  services: Service[];
}

const { lang, settings, services } = Astro.props;
const t = ui(lang).services;
const body = `${t.bodyPre} ${t.bodyEmpty}`;
const mailto = `mailto:${settings.email}?subject=${encodeURIComponent(t.subject)}&body=${encodeURIComponent(body)}`;
const pad = (n: number) => String(n).padStart(2, '0');
// Cada tarjeta tiene su luz; si desde Sanity se suman servicios, los colores se repiten
const COLORS = ['#8b6cff', '#4f7bff', '#ff8a5b', '#f5c76b', '#5ee6a8'];
---

<section
  id="servicios"
  class="services"
  data-services
  data-email={settings.email}
  data-whatsapp={settings.whatsapp.replace(/\D/g, '')}
  data-subject={t.subject}
  data-body-pre={t.bodyPre}
  data-body-empty={t.bodyEmpty}
  data-add={t.add}
  data-added={t.added}
>
  <div class="wrap">
    <div class="head" data-reveal>
      <div>
        <p class="label kicker">{t.kicker}</p>
        <h2 class="title display">{t.title}</h2>
      </div>
      <p class="intro">{t.copy}</p>
    </div>

    <ul class="sgrid">
      {
        services.map((s, i) => (
          <li data-reveal style={`--reveal-index:${Math.min(i, 6)}`}>
            <button
              type="button"
              class="scard"
              aria-pressed="false"
              data-service={s.title}
              data-color={COLORS[i % COLORS.length]}
              style={`--c:${COLORS[i % COLORS.length]}`}
            >
              <span class="slight" aria-hidden="true"></span>
              <span class="scard-top">
                <span class="mono scard-n">{pad(i + 1)}</span>
                <span class="sdot" aria-hidden="true"></span>
              </span>
              <span class="sctitle">{s.title}</span>
              <span class="scdesc">{s.description}</span>
              <span class="sadd mono" data-add-label>{t.add}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="request-wrap" data-request>
      <div class="halo halo-l" aria-hidden="true"></div>
      <div class="halo halo-r" aria-hidden="true"></div>
      <div class="request">
        <img src="/img/fiamma-avatar.webp" alt="" width="40" height="40" loading="lazy" />
        <div class="request-body">
          <p class="mono request-label">{t.ticketLabel} <span>{t.available}</span></p>
          <div class="chosen" aria-live="polite">
            <p class="empty" data-empty>{t.empty}</p>
            <ul class="picked" data-picked></ul>
          </div>
        </div>
        <div class="request-actions">
          <a href={whatsappUrl(settings.whatsapp, body)} target="_blank" rel="noopener" class="sbtn sbtn-wa" data-wa>{t.whatsapp}</a>
          <a href={mailto} class="sbtn sbtn-mail" data-mail>{t.email} <Icon name="arrow-up-right" size={14} /></a>
        </div>
      </div>
    </div>

    <p class="soux-note">
      <a href={settings.souxion.url} target="_blank" rel="noopener" class="mono">
        <img src="/img/souxion-icono.webp" alt="" width="14" height="11" />{t.souxion} ↗
      </a>
    </p>
  </div>
</section>

<script>
  import '@/scripts/services';
</script>

<style>
  .services {
    position: relative;
    margin-top: 140px;
    padding: 110px var(--gutter) 120px;
    background: linear-gradient(180deg, var(--bg) 0%, #0f0a26 55%, var(--bg) 100%);
    overflow: hidden;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 44px;
  }
  .kicker {
    color: var(--lilac);
  }
  .title {
    font-size: clamp(24px, 7vw, 56px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    max-width: 12ch;
  }
  .intro {
    max-width: 380px;
    color: #c9c1e6;
    font-size: 16px;
    line-height: 1.6;
  }

  /* ---------- Tarjetas ---------- */
  .sgrid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px;
  }
  .sgrid li {
    display: flex;
  }
  .scard {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-height: 340px;
    padding: 22px;
    border-radius: 22px;
    overflow: hidden;
    background: rgba(14, 10, 26, 0.75);
    border: 1px solid rgba(196, 181, 255, 0.14);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }
  .scard:focus-visible {
    outline: 2px solid var(--lilac);
    outline-offset: 3px;
  }
  .scard:active {
    transform: scale(0.98);
  }
  .slight {
    position: absolute;
    left: -20%;
    right: -20%;
    bottom: -55%;
    height: 90%;
    border-radius: 50%;
    filter: blur(36px);
    background: radial-gradient(ellipse at center, var(--c), transparent 65%);
    opacity: 0;
    transform: translateY(30%);
    transition:
      opacity 0.6s ease,
      transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
    pointer-events: none;
  }
  .scard-top {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .scard-n {
    font-size: 12px;
    color: var(--muted-2);
  }
  .sdot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgba(196, 181, 255, 0.25);
    transition:
      background 0.4s ease,
      box-shadow 0.4s ease;
  }
  .sctitle {
    position: relative;
    margin-top: auto;
    padding-top: 40px;
    font-size: 28px;
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text);
  }
  .scdesc {
    position: relative;
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.55;
    color: #b9b1d6;
  }
  .sadd {
    position: relative;
    margin-top: 20px;
    font-size: 12px;
    color: var(--c);
  }
  @media (hover: hover) {
    .scard:hover {
      transform: translateY(-8px);
      border-color: var(--c);
    }
    .scard:hover .slight {
      opacity: 0.55;
      transform: none;
    }
  }
  .scard[aria-pressed='true'] {
    border-color: var(--c);
    box-shadow:
      0 0 0 1px var(--c),
      0 30px 80px -20px var(--c);
  }
  .scard[aria-pressed='true'] .slight {
    opacity: 0.7;
    transform: none;
  }
  .scard[aria-pressed='true'] .sdot {
    background: var(--c);
    box-shadow: 0 0 14px var(--c);
  }
  .scard[aria-pressed='true'] .sadd {
    color: #fff;
  }

  /* ---------- Barra "Tu consulta" ---------- */
  .request-wrap {
    position: relative;
    display: flex;
    justify-content: center;
    margin-top: 56px;
    transition:
      --svc-l 0.7s ease,
      --svc-r 0.7s ease;
  }
  .halo {
    position: absolute;
    top: 50%;
    width: 420px;
    height: 240px;
    margin-top: -120px;
    border-radius: 50%;
    filter: blur(32px);
    pointer-events: none;
    animation: breathe 6s ease-in-out infinite;
  }
  .halo-l {
    left: calc(50% - 560px);
    background: radial-gradient(ellipse at 70% 50%, color-mix(in srgb, var(--svc-l) 45%, transparent), transparent 62%);
  }
  .halo-r {
    right: calc(50% - 560px);
    animation-delay: -3s;
    background: radial-gradient(ellipse at 30% 50%, color-mix(in srgb, var(--svc-r) 45%, transparent), transparent 62%);
  }
  .request {
    position: relative;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    width: 100%;
    max-width: 900px;
    padding: 14px 14px 14px 18px;
    border-radius: 22px;
    border: 1px solid transparent;
    background:
      linear-gradient(#0c0a16, #0c0a16) padding-box,
      linear-gradient(
          90deg,
          color-mix(in srgb, var(--svc-l) 90%, transparent),
          rgba(196, 181, 255, 0.12) 40%,
          rgba(196, 181, 255, 0.12) 60%,
          color-mix(in srgb, var(--svc-r) 90%, transparent)
        )
        border-box;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
  }
  .request > img {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 2px var(--accent);
  }
  .request-body {
    flex: 1 1 260px;
    min-width: 0;
  }
  .request-label {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted-2);
  }
  .request-label span {
    margin-left: 6px;
    color: var(--green);
    text-transform: none;
    letter-spacing: 0;
  }
  .chosen {
    margin-top: 8px;
    min-height: 28px;
    display: flex;
    align-items: center;
  }
  .empty {
    font-size: 14px;
    color: var(--muted-2);
  }
  .empty[hidden] {
    display: none;
  }
  .picked {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .picked :global(li) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    font-size: 12.5px;
    color: var(--text);
    background: color-mix(in srgb, var(--c) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
    animation: fade-up 0.3s ease both;
  }
  .picked :global(li)::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--c);
  }
  .request-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    font-size: 14px;
    white-space: nowrap;
  }
  .sbtn-wa {
    border: 1px solid rgba(196, 181, 255, 0.3);
    color: var(--text);
  }
  .sbtn-wa:hover {
    border-color: var(--lilac);
  }
  .sbtn-mail {
    background: linear-gradient(135deg, #e0623a, var(--accent));
    color: #fff;
    font-weight: 500;
    box-shadow: 0 10px 30px rgba(124, 92, 255, 0.35);
  }
  .sbtn-mail:hover {
    color: #fff;
    filter: brightness(1.1);
  }
  .soux-note {
    position: relative;
    margin-top: 18px;
    text-align: center;
  }
  .soux-note a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--peach);
  }
  .soux-note img {
    width: 14px;
    height: auto;
  }

  @media (max-width: 760px) {
    .services {
      margin-top: 80px;
      padding: 72px var(--gutter);
    }
    /* En celular las tarjetas se deslizan de costado */
    .sgrid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-left: var(--gutter);
      gap: 12px;
      margin: 0 calc(-1 * var(--gutter));
      padding: 6px var(--gutter) 14px;
      scrollbar-width: none;
    }
    .sgrid::-webkit-scrollbar {
      display: none;
    }
    .sgrid li {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
    /* Las tarjetas fuera de pantalla no deben esperar al scroll para aparecer al deslizar */
    :global(.js) .sgrid li[data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .scard {
      min-height: 250px;
      padding: 18px;
    }
    /* El carrusel recorta lo que sobresale: acá la tarjeta elegida lleva solo el borde */
    .scard[aria-pressed='true'] {
      box-shadow: 0 0 0 1px var(--c);
    }
    .request-body {
      flex-basis: 200px;
    }
    .sctitle {
      font-size: 24px;
    }
    .request-wrap {
      margin-top: 28px;
    }
    .request {
      padding: 14px;
    }
    .sbtn {
      flex: 1 1 auto;
    }
    .soux-note a {
      line-height: 1.5;
    }
  }
</style>
