---
import { ui } from '@/lib/ui';
import type { Lang, Settings } from '@/lib/types';

interface Props {
  lang: Lang;
  settings: Settings;
}

const { lang, settings } = Astro.props;
const t = ui(lang);
const photo = settings.aboutPhoto;
// Cada palabra del párrafo principal se enciende al scrollear (scroll-fx.ts)
const words = (text: string) => text.split(/\s+/).filter(Boolean);
const leadWords = words(settings.aboutLead);
// "20+" → cuenta de 0 a 20 y conserva el "+" y los ceros a la izquierda ("04")
const counter = (value: string) => {
  const m = value.match(/^(\d+)(.*)$/);
  return m ? { 'data-countup': m[1], 'data-suffix': m[2], 'data-pad': m[1].length } : {};
};
---

<section id="sobre" class="section">
  <div class="wrap about">
    <div class="media" data-reveal>
      <div class="photo">
        <img src={photo.url} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" data-parallax />
        <span class="file mono">// sobre_mi.md</span>
      </div>
      <div class="bubbles">
        {
          settings.stats.map((s, i) => (
            <div class:list={['bubble', s.tone]} style={`--i:${i}`}>
              <span class="value" {...counter(s.value)}>{s.value}</span>
              <span class="mono">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
    <div class="text" data-reveal>
      <p class="label">{t.about.kicker}<span class="label-sub">UTN · SOUXION</span></p>
      <h2 class="h2 display sans title" data-words="title" aria-label={`${t.about.title} ${t.about.highlight}`}>
        {words(t.about.title).map((word) => <><span class="w" aria-hidden="true">{word}</span>{' '}</>)}
        <span class="hl">
          {words(t.about.highlight).map((word) => <><span class="w" aria-hidden="true">{word}</span>{' '}</>)}
        </span>
      </h2>
      <p class="short">{t.about.shortPre} <a href="#souxion">SOUXION</a>{t.about.shortPost}</p>
      <p class="lead" data-words>
        {leadWords.map((word) => <span class="w">{`${word} `}</span>)}
      </p>
      <p class="copy">{settings.aboutCopy}</p>
      <ul class="traits">
        {settings.traits.map((trait) => <li class="chip">{trait}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }
  .media {
    flex: 1 1 380px;
    min-width: 0;
    position: relative;
  }
  .photo {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid rgba(196, 181, 255, 0.18);
    aspect-ratio: 4 / 5;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.2) contrast(1.05);
  }
  /* Parallax: la foto es un poco más grande que el marco y se desliza (scroll-fx.ts) */
  :global(.js) .photo img {
    scale: 1.12;
    translate: 0 var(--py, 0%);
    will-change: translate;
  }
  /* Palabras apagadas hasta que el scroll las enciende */
  :global(.js) .lead .w {
    color: rgba(220, 212, 255, 0.26);
    transition: color 0.35s ease;
  }
  :global(.js) .lead .w.is-lit {
    color: var(--text-soft);
  }
  .file {
    position: absolute;
    left: 20px;
    bottom: 20px;
    padding: 8px 12px;
    border-radius: 999px;
    background: rgba(8, 6, 15, 0.7);
    backdrop-filter: blur(8px);
    font-size: 12px;
    color: var(--text-soft);
  }
  .bubble {
    position: absolute;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    animation: float calc(6s + var(--i) * 1s) ease-in-out calc(var(--i) * -2s) infinite;
  }
  .bubble .value {
    font-size: 38px;
    font-weight: 300;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .bubble .mono {
    font-size: 10px;
    margin-top: 6px;
    max-width: 90px;
    line-height: 1.3;
  }
  .bubble.accent {
    right: -50px;
    top: 40px;
    width: 132px;
    height: 132px;
    background: var(--accent);
    box-shadow: 0 20px 60px rgba(124, 92, 255, 0.5);
  }
  .bubble.outline {
    right: -24px;
    top: 200px;
    width: 116px;
    height: 116px;
    border: 1px solid rgba(243, 240, 255, 0.5);
    background: rgba(8, 6, 15, 0.55);
    backdrop-filter: blur(10px);
  }
  .bubble.orange {
    right: -60px;
    top: 340px;
    width: 124px;
    height: 124px;
    background: var(--peach);
    color: #1a0e08;
  }
  .text {
    flex: 1.3 1 480px;
    min-width: 0;
  }
  .h2 {
    margin-bottom: 32px;
  }
  .lead {
    font-size: 21px;
    line-height: 1.55;
    color: var(--text-soft);
    font-weight: 300;
  }
  .copy {
    margin-top: 22px;
    font-size: 17px;
    line-height: 1.7;
    color: var(--muted);
  }
  /* ---------- Cartel de aeropuerto ---------- */
  .traits {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
  .short,
  .label-sub {
    display: none;
  }
  /* En celular: título, texto corto con la foto chica al lado y el cartel debajo */
  @media (max-width: 760px) {
    .about {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 142px;
      column-gap: 16px;
      row-gap: 0;
      align-items: start;
    }
    .text {
      display: contents;
    }
    .text > * {
      grid-column: 1 / -1;
    }
    .label-sub {
      display: block;
      color: var(--text-soft);
    }
    .title {
      margin-bottom: 18px;
    }
    .text > .short {
      display: block;
      grid-column: 1;
      grid-row: 3;
      font-size: 16px;
      line-height: 1.6;
      font-weight: 300;
      color: var(--text-soft);
    }
    .short a {
      color: var(--peach);
    }
    .media {
      grid-column: 2;
      grid-row: 3;
      margin-top: 4px;
    }
    .photo {
      height: 188px;
      aspect-ratio: auto;
      border-radius: 16px;
    }
    .file,
    .bubbles,
    .lead,
    .copy {
      display: none;
    }
    /* Las etiquetas se deslizan de costado en una sola fila */
    .text > .traits {
      flex-wrap: nowrap;
      gap: 6px;
      overflow-x: auto;
      margin: 22px calc(-1 * var(--gutter)) 0;
      padding: 0 var(--gutter) 4px;
      scrollbar-width: none;
    }
    .traits::-webkit-scrollbar {
      display: none;
    }
    .traits .chip {
      flex: none;
      padding: 7px 12px;
      font-size: 11.5px;
    }
  }
</style>
